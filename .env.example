# Copy this file to `.env` and fill in real values (or set these as environment
# variables on your host). `.env` is gitignored, so your real secrets never
# reach the repository. All of these are optional — the app runs without them,
# but invoices need a real IBAN and a fresh deploy needs admin credentials.

# --- Payment details shown on invoices ---
PAYMENT_IBAN=FI00 0000 0000 0000 00
PAYMENT_PAYEE=Your Business Name
# Optional: a MobilePay number to also accept mobile payments (leave blank to skip)
PAYMENT_MOBILEPAY=+358 40 000 0000

# --- Initial admin + coach (Kalle) logins, created on the very first run ---
# If an ADMIN_PASSWORD / COACH_PASSWORD is not set, a strong random password is
# generated and printed to the server log once — grab it from there.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
COACH_EMAIL=coach@example.com
COACH_PASSWORD=choose-a-strong-password

# --- Payments: MobilePay (the only payment method) ---
# Nobody pays at checkout. A booking is invoiced and waits in pending payment
# until the money arrives at this number, using the invoice number as the
# message/reference. Defaults to the owner's number if unset.
# PAYMENT_MOBILEPAY=+358 44 9872431
#
# Automatic confirmation needs a Vipps MobilePay MERCHANT agreement — a
# PERSONAL number has no API. With the secret set, POST /api/mobilepay/webhook
# matches incoming payments to bookings by reference; without it, an admin
# marks them paid in the dashboard (which is the normal flow today).
# MOBILEPAY_WEBHOOK_SECRET=
# MOBILEPAY_MERCHANT_SERIAL=

# --- Optional: real invoice emails via any SMTP provider ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Proballers Coaching <no-reply@yourdomain.fi>"

# --- Optional: Google Sheets sync (service account) ---
# GOOGLE_SERVICE_ACCOUNT=/path/to/service-account.json
# GOOGLE_SHEET_ID=

# --- Optional: Attio CRM one-way sync (customers/leads -> People, bookings -> Deals) ---
# Access token from Attio: Settings -> Developers. Scopes: record_permission:read-write
# and object_configuration:read-write. Seed existing data once with
# `node scripts/attio-backfill.js`. See README "Connect Attio".
# ATTIO_API_KEY=

# --- Optional: daily brief endpoint (GET /api/brief) ---
# Set a long random secret to turn the read-only daily-brief endpoint ON; a
# scheduler fetches /api/brief?token=<value> (add &send=1 to email it). Without
# it the endpoint is disabled (404). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# BRIEF_TOKEN=
